from building import *
import os

cwd = GetCurrentDir()
motor_src = ['motor_openloop.c', 'motor_sensorless.c']
src = [s for s in Glob('*.c') if os.path.basename(str(s)) not in motor_src]
CPPPATH = [cwd]

group = DefineGroup('Applications', src, depend = [''], CPPPATH = CPPPATH)

list = os.listdir(cwd)
for item in list:
    if os.path.isfile(os.path.join(cwd, item, 'SConscript')):
        group = group + SConscript(os.path.join(item, 'SConscript'))

Return('group')
